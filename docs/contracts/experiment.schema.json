{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nfloser/vesicle-scope/docs/contracts/experiment.schema.json",
  "title": "VesicleScope v0.1 experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "model_class",
    "engine",
    "domain",
    "time",
    "transport",
    "donors",
    "recipients"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "model_class": {
      "enum": ["continuum", "particle"]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_um", "height_um", "slice_thickness_um", "boundary"],
      "properties": {
        "width_um": { "type": "number", "exclusiveMinimum": 0 },
        "height_um": { "type": "number", "exclusiveMinimum": 0 },
        "slice_thickness_um": { "type": "number", "exclusiveMinimum": 0 },
        "boundary": { "enum": ["no_flux", "periodic", "absorbing"] }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_min", "sample_every_min"],
      "properties": {
        "duration_min": { "type": "number", "exclusiveMinimum": 0 },
        "sample_every_min": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diffusion", "degradation"],
      "properties": {
        "diffusion": { "$ref": "#/$defs/diffusionParameter" },
        "degradation": { "$ref": "#/$defs/rateParameter" }
      }
    },
    "donors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "center_um", "radius_um", "cell_count", "release_rate"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "center_um": { "$ref": "#/$defs/point2d" },
          "radius_um": { "type": "number", "exclusiveMinimum": 0 },
          "cell_count": { "type": "integer", "minimum": 1 },
          "release_rate": { "$ref": "#/$defs/releaseParameter" }
        }
      }
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "center_um", "radius_um", "uptake_rate"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "center_um": { "$ref": "#/$defs/point2d" },
          "radius_um": { "type": "number", "exclusiveMinimum": 0 },
          "uptake_rate": { "$ref": "#/$defs/rateParameter" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "model_class": { "const": "particle" } },
        "required": ["model_class"]
      },
      "then": {
        "properties": {
          "engine": { "required": ["seed"] }
        }
      }
    }
  ],
  "$defs": {
    "evidenceClass": {
      "enum": ["observed", "literature", "fitted", "assumed", "synthetic"]
    },
    "point2d": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "diffusionParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "evidence_id", "evidence_class"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "const": "um^2/min" },
        "evidence_id": { "type": "string", "minLength": 1 },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" }
      }
    },
    "rateParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "evidence_id", "evidence_class"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "const": "1/min" },
        "evidence_id": { "type": "string", "minLength": 1 },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" }
      }
    },
    "releaseParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "evidence_id", "evidence_class"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "const": "particle_equivalent/(cell*min)" },
        "evidence_id": { "type": "string", "minLength": 1 },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" }
      }
    }
  }
}
